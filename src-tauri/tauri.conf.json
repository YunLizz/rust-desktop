{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "锦书",
  "version": "0.1.0",
  "identifier": "com.jinshu.editor",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "锦书 · 小说编辑器",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      }
    }
  }
}